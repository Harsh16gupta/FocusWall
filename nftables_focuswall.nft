        elements = { 2606:4700:4700::1111, 2606:4700:4700::1001, 2001:4860:4860::8888, 2001:4860:4860::8844, 2620:fe::fe, 2620:fe::9, 2620:119:35::35, 2620:119:53::53, 2a10:50c0::ad1:ff, 2a10:50c0::ad2:ff }
    }

    chain output {
        type filter hook output priority 0; policy accept;

        # Drop outbound TCP/UDP to blocked domain IPv4s
        ip daddr @blocked_ipv4 tcp dport { 80, 443, 8080, 8443 } drop
        ip daddr @blocked_ipv4 udp dport { 80, 443 } drop

        # Drop outbound TCP/UDP to blocked domain IPv6s
        ip6 daddr @blocked_ipv6 tcp dport { 80, 443, 8080, 8443 } drop
        ip6 daddr @blocked_ipv6 udp dport { 80, 443 } drop

        # Prevent DNS bypass via known public DoH/DoT/DNS resolvers while enforcing
